<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot parent handles:
        - Dependency version management (no need to specify versions below)
        - Maven plugin defaults
        - Resource filtering
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>hello-docker</artifactId>
    <version>1.0.0</version>
    <name>hello-docker</name>
    <description>Simple Spring Boot app — Java equivalent of my-first-docker-app (JS)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- Web layer: enables @RestController, @GetMapping, embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Actuator: auto-exposes /actuator/health — used by Dockerfile HEALTHCHECK -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              spring-boot-maven-plugin packages the app as a single executable "fat JAR"
              that includes all dependencies and an embedded Tomcat server.
              JS equivalent: npm run build (bundles everything into one artifact)
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
